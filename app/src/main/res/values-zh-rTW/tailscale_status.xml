<resources>
    <string name="tailscale_status_title">Tailscale 狀態</string>
    <string name="tailscale_status_entry">看已儲存設定檔的狀態、登入與對等節點診斷；還沒儲存的修改不算。</string>
    <string name="tailscale_status_connecting">正在連線至服務…</string>
    <string name="tailscale_status_stopped">這個已儲存的節點沒在跑。開這一頁不會幫它啟動。</string>
    <string name="tailscale_status_check">檢查 / 登入</string>
    <string name="tailscale_status_check_summary">服務停下來時才能用。會啟動一個臨時節點，不是 VPN。</string>
    <string name="tailscale_status_starting">正在啟動臨時檢查…</string>
    <string name="tailscale_status_temporary">這是臨時的檢查用連線，服務只給 3 分鐘。從瀏覽器登入完回到這裡會沿用同一條；離開這一頁就結束。</string>
    <string name="tailscale_status_cancel">取消臨時檢查</string>
    <string name="tailscale_status_closed">檢查已結束。需要的話請再跑一次。</string>
    <string name="tailscale_status_error">這個動作沒完成。請檢查已儲存的設定檔和服務狀態，再試一次。</string>
