<?xml version="1.0" encoding="utf-8"?>
<com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/configuration_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="48dp"
    android:scrollbarSize="0dp"
    app:fastScrollAutoHide="true"
    app:fastScrollPopupTextColor="@color/zybc_teal_soft"
    app:fastScrollThumbColor="@color/zybc_teal"
    app:fastScrollThumbInactiveColor="@color/zybc_surface_border"
    tools:listitem="@layout/layout_profile" />
