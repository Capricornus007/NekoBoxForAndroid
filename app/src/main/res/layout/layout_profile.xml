<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="96dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content_lin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:orientation="horizontal"
            android:paddingEnd="6dp"
            tools:ignore="RtlSymmetry">

            <!-- 四行：名稱 / 協定 / 地址 / 流量。座標與流量各自獨立一行，
                 可見度由 ConfigurationGroupFragment 分別控制（不再共用一行）。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingVertical="12dp"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Amsterdam · NL" />

                <TextView
                    android:id="@+id/profile_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="VLESS" />

                <TextView
                    android:id="@+id/profile_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="nl-ams-01.example.com:8443" />

                <TextView
                    android:id="@+id/traffic_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="▲ 12 MB ↓ 340 MB"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 節點狀態（延遲 / 超時 / 正在測速）放在三點按鈕左側，兩者也留間距。
                 錯誤原文可能很長，所以限寬並截斷：點它會彈出完整錯誤（profileStatus 有 click listener）。 -->
            <TextView
                android:id="@+id/profile_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="150dp"
                android:minWidth="56dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/ui_success"
                tools:text="18 ms" />

            <!-- 節點清單把這三個圖標全部隱藏（動作一律收進 double_column_menu 的三點菜單），
                 但 layout 是共用的：Chain／Balancer 兩個設定頁仍直接點這三個 View，必須留著。 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_image_edit"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shareIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_social_share"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/double_column_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_baseline_more_vert_24"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/remove"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:focusable="true"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_action_delete" />
        </LinearLayout>


    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
