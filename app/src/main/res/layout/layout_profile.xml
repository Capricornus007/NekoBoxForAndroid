<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="92dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content_lin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:orientation="horizontal"
            android:paddingEnd="6dp"
            tools:ignore="RtlSymmetry">

            <!-- 文字欄：名稱 / 協定＋狀態 / 地址＋流量。左側那顆 40dp 圓形 hub 圖示已移除——
                 它在 Kotlin 裡從未被引用（純裝飾），卻固定吃掉 50dp 寬度。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingVertical="12dp"
                tools:ignore="RtlSymmetry">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Amsterdam · NL" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/profile_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="VLESS" />

                    <TextView
                        android:id="@+id/profile_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/ui_success"
                        tools:text="18 ms" />
                </LinearLayout>

                <!-- 這一行由 ConfigurationGroupFragment 用「有流量或有地址才顯示」控制
                     （它抓的是 traffic_text.parent），所以流量文字必須待在同一行裡。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/profile_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:breakStrategy="simple"
                        android:ellipsize="end"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="nl-ams-01.example.com:8443" />

                    <TextView
                        android:id="@+id/traffic_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="12 MB"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- 節點清單（ConfigurationGroupFragment）把這三個圖標全部隱藏，動作一律收進
                 double_column_menu 的三點選單；但 layout 是共用的，Chain／Balancer 兩個設定頁
                 仍直接點這三個 View，所以它們必須留在這裡。 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_image_edit"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shareIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_social_share"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/double_column_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:focusable="true"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_baseline_more_vert_24"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/remove"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:focusable="true"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_action_delete" />
        </LinearLayout>


    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
