<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:importantForAutofill="no" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/keyboard_container"
        android:background="?attr/colorSurfaceContainerHigh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/action_tab"
            android:contentDescription="@string/editor_tab"
            android:focusable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/baseline_keyboard_tab_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <moe.matsuri.nb4a.ui.ExtendedKeyboard
            android:id="@+id/extended_keyboard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="6"
            tools:listitem="@layout/item_keyboard_key" />

        <ImageView
            android:id="@+id/action_undo"
            android:contentDescription="@string/editor_undo"
            android:focusable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/baseline_undo_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/action_redo"
            android:contentDescription="@string/editor_redo"
            android:focusable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/baseline_redo_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/action_format"
            android:contentDescription="@string/editor_format"
            android:focusable="true"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_format_align_left_24"
            app:tint="?attr/colorOnSurfaceVariant" />


    </LinearLayout>

</LinearLayout>