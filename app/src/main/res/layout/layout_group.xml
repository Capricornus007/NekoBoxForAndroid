<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_zybc_main_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:theme="?actionBarTheme"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
            app:title="@string/menu_group"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView
        android:id="@+id/group_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp"
        android:scrollbarSize="0dp"
        app:fastScrollAutoHide="true"
        app:fastScrollPopupTextColor="@color/zybc_teal_soft"
        app:fastScrollThumbColor="@color/zybc_teal"
        app:fastScrollThumbInactiveColor="@color/zybc_surface_border"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    </com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
