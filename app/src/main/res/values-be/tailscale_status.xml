<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tailscale_status_title">Статус Tailscale</string>
    <string name="tailscale_status_entry">Стан, уваход і дыягностыка вузлоў для захаванага профілю. Незахаваныя змяненні не выкарыстоўваюцца.</string>
    <string name="tailscale_status_connecting">Подключение к службе…</string>
    <string name="tailscale_status_stopped">Гэты захаваны вузел не запушчаны. Адкрыццё гэтага экрана не запускае яго.</string>
    <string name="tailscale_status_check">Проверить / войти</string>
    <string name="tailscale_status_check_summary">Толькі когда служба спынена. Запускае часовы вузел, а не VPN.</string>
    <string name="tailscale_status_starting">Запуск часовы праверкі…</string>
    <string name="tailscale_status_temporary">Часовая сесія, ограниченная службой тремя минутами. Вяртанне з браўзэра уваходу захоўвае тую жа сесія. Выхад з гэтага экрана завяршае яе.</string>
    <string name="tailscale_status_cancel">Скасаваць часовую сесію</string>
    <string name="tailscale_status_closed">Сесія завершана. Праверце зноў яўна пры неабходнасці.</string>
    <string name="tailscale_status_error">Не ўдалося завяршыць аперацыю. Праверце захаваны профіль і стан службы, затым паўтарыце спробу.</string>
    <string name="tailscale_status_backend">Стан вузла: %1$s</string>
    <string name="tailscale_status_approval">Ожидание одобрения администратора</string>
    <string name="tailscale_status_key_auth">Настроен уваход по Auth-key</string>
    <string name="tailscale_status_interactive_auth">Настроен интерактыўны уваход</string>
    <string name="tailscale_status_self">Гэты вузел</string>
    <string name="tailscale_status_unknown">Недаступна</string>
    <string name="tailscale_status_online">У сетцы</string>
    <string name="tailscale_status_offline">Не ў сетцы</string>
    <string name="tailscale_status_expired">Ключ вузла сышоў</string>
    <string name="tailscale_status_expiry">Сканчэнне ключа: %1$s</string>
    <string name="tailscale_status_expiry_unknown">Сканчэнне ключа недаступна</string>
    <string name="tailscale_status_current_exit">Бягучы выхад</string>
    <string name="tailscale_status_saved_exit">Захаваны выхад</string>
    <string name="tailscale_status_none">Нет — толькі tailnet</string>
    <string name="tailscale_status_exit_live">%1$s — активен</string>
    <string name="tailscale_status_exit_not_live">%1$s — не активен</string>
    <string name="tailscale_status_exit_mismatch">Захаваны выбор адличаецца ад бягучага выхаду.</string>
    <string name="tailscale_status_exit_offer">Прапануе маршрутызацыю выхаду</string>
    <string name="tailscale_status_exit_selected">Выбраны выхад</string>
    <string name="tailscale_status_exit_action">Змяніць і захаваць выхад</string>
    <string name="tailscale_status_exit_confirm">Ужыць %1$s к гэтаму узлу і захаваць яго у профиле? Экран чакае пацверджання як ад вузла, так і ад базы даных.</string>
    <string name="tailscale_status_none_warning">Нет пакідае даступныями толькі tailnet-адрасы; ён не прадастаўляе выхад у Інтэрнэт.</string>
    <string name="tailscale_status_exit_pending">Ужыванне і захаванне выбора выхаду…</string>
    <string name="tailscale_status_exit_saved">Выхад прыменён і захаваны</string>
    <string name="tailscale_status_exit_next_start">Выхад захаваны для наступнага запуска</string>
    <string name="tailscale_status_exit_unchanged">Змяненне выхаду не ўдалося; папярэдні выбор не зменены</string>
    <string name="tailscale_status_exit_rolled_back">Захаванне не ўдалося; папярэдні актыўны выхад адноўлены</string>
    <string name="tailscale_status_exit_conflict">Захаваны профіль змяніўся. Праглядзіце бягучы захаваны выхад перад паўторнай попыткой.</string>
    <string name="tailscale_status_exit_diverged">Актыўны і захаваны выхады могуць адрознівацца. Праглядзіце абодва стану; VPN не был перазапушчаны.</string>
    <string name="tailscale_status_exit_cancelled">Змяненне выхаду скасавана да ужывання</string>
    <string name="tailscale_status_peers">Вузлы</string>
    <string name="tailscale_status_no_peers">Ввузлы не паведамлены</string>
    <string name="tailscale_status_inventory">Паказана %1$d з %2$d вузлоў — інвентар няпоўны</string>
    <string name="tailscale_status_inventory_complete">%1$d вузлоў</string>
    <string name="tailscale_status_ping">Пінг вузла</string>
    <string name="tailscale_status_ping_summary">Яўная disco RTT-праверка, да пяці выбарак і дзесяці секунд. Аўтаматычнага сканавання нет.</string>
    <string name="tailscale_status_ping_pending">Вымярэнне RTT вузла…</string>
    <string name="tailscale_status_ping_result">%1$s · %2$s · %3$s</string>
    <string name="tailscale_status_ping_latency">%1$.1f ms</string>
    <string name="tailscale_status_ping_error">Пінг не удался</string>
    <string name="tailscale_status_path_direct">Прамы</string>
    <string name="tailscale_status_path_derp">DERP %1$s</string>
    <string name="tailscale_status_path_peer_relay">Рэтрансляцыя вузла</string>
    <string name="tailscale_status_path_unknown">Невядомы шлях</string>
    <string name="tailscale_status_cancel_request">Скасаваць запыт</string>
    <string name="tailscale_status_cancel_request_summary">Змяненне выхаду, ужо захоўваемае, павінна завяршыць захаванне або адкаціцца.</string>
    <string name="tailscale_status_login_origin">Крыніца уваходу: %1$s</string>
    <string name="tailscale_login_http_warning">Эта старонка уваходу выкарыстоўвае HTTP без абароны HTTPS. Спасылка уваходу і даныя уваходу могуць быть выкрытыя іншым у сетцы. Працягвайце, толькі калі давяраеце гэтаму злучэнню.</string>
    <string name="tailscale_login_continue">Продолжить</string>
    <string name="tailscale_status_login_invalid">Адрас уваходу недаступны або небяспечны. Праверце захаваны кантрольны URL.</string>
    <string name="tailscale_status_login_warning">Неаўтэнтыфікаваны маршрут VPN па змаўчанні або блакіроўка VPN у Android можа перашкодзіць браўзэру дасягнуць гэтай старонкі. Гэты экран не змяняе налады VPN або блакіроўкі і не абходзіць маршрутызацыю.</string>
    <string name="tailscale_editor_conflict">Ідэнтычнасць або захаваны выхад змяніліся. Вашыя чарнавікі засталіся. Зноў адкрыйце рэдактар, каб праглядзеть захаваны профіль перад змяненнем выхаду.</string>
    <string name="tailscale_editor_save_failed">Не ўдалося захаваць профіль. Вашыя чарнавікі засталіся.</string>
