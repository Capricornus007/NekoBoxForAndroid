<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="serverAddress"
            app:title="@string/server_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="serverPort"
            app:title="@string/server_port"
            app:useSimpleSummaryProvider="true" />
        <io.nekohasekai.sagernet.widget.MultilineEditTextPreference
            app:icon="@drawable/ic_baseline_domain_24"
            app:key="localAddress"
            app:title="@string/wireguard_local_address"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="privateKey"
            app:title="@string/ssh_private_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="peerPublicKey"
            app:title="@string/wireguard_public_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="peerPreSharedKey"
            app:title="@string/wireguard_psk" />
        <EditTextPreference
            app:defaultValue="1420"
            app:icon="@drawable/baseline_public_24"
            app:key="mtu"
            app:title="@string/mtu"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_fingerprint_24"
            app:key="reserved"
            app:title="Reserved"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/wireguard_imported_options">
        <io.nekohasekai.sagernet.widget.MultilineEditTextPreference
            app:key="dnsServers" app:title="DNS" app:useSimpleSummaryProvider="true" />
        <io.nekohasekai.sagernet.widget.MultilineEditTextPreference
            app:key="allowedIPs" app:title="AllowedIPs" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="persistentKeepalive" app:dialogMessage="@string/amneziawg_range_hint" app:title="PersistentKeepalive" app:defaultValue="0" app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat app:key="useConfigRoutes" app:title="@string/wireguard_use_config_routes" app:summary="@string/wireguard_use_config_routes_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/amneziawg_category">
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="jc"
            app:title="@string/amneziawg_jc"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="jmin"
            app:title="@string/amneziawg_jmin"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="jmax"
            app:title="@string/amneziawg_jmax"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="s1"
            app:title="@string/amneziawg_s1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="s2"
            app:title="@string/amneziawg_s2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="s3"
            app:title="@string/amneziawg_s3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="s4"
            app:title="@string/amneziawg_s4"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="h1"
            app:title="@string/amneziawg_h1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="h2"
            app:title="@string/amneziawg_h2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="h3"
            app:title="@string/amneziawg_h3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="h4"
            app:title="@string/amneziawg_h4"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="i1"
            app:title="@string/amneziawg_i1"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="i2"
            app:title="@string/amneziawg_i2"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="i3"
            app:title="@string/amneziawg_i3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="i4"
            app:title="@string/amneziawg_i4"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_texture_24"
            app:key="i5"
            app:title="@string/amneziawg_i5"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="AmneziaWG 3.1">
        <EditTextPreference app:key="headerProtectionKey" app:title="HeaderProtectionKey" app:dialogLayout="@layout/layout_password_dialog" app:dialogMessage="@string/amneziawg_header_key_hint" />
        <EditTextPreference app:key="contentPaddingAddition" app:title="ContentPaddingAddition" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="rekeyAfterTime" app:title="RekeyAfterTime" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="rekeyTimeout" app:title="RekeyTimeout" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="rejectAfterTime" app:title="RejectAfterTime" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="keepaliveTimeout" app:title="KeepaliveTimeout" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="maxHandshakeAttempts" app:title="MaxHandshakeAttempts" app:dialogMessage="@string/amneziawg_range_hint" app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat app:key="randomTrailers" app:title="RandomTrailers" app:summary="@string/amneziawg_random_trailers_hint" />
        <SwitchPreferenceCompat app:key="disableCookies" app:title="DisableCookies" app:summary="@string/amneziawg_disable_cookies_hint" />
    </PreferenceCategory>

</PreferenceScreen>
