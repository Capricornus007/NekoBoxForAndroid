<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory app:title="@string/proxy_cat">

        <EditTextPreference
            app:dialogMessage="@string/openvpn_one_per_line"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="servers"
            app:title="@string/openvpn_servers"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="udp"
            app:entries="@array/openvpn_transport_value"
            app:entryValues="@array/openvpn_transport_value"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="transport"
            app:title="@string/openvpn_transport"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:icon="@drawable/ic_baseline_domain_24"
            app:key="remoteRandom"
            app:title="@string/openvpn_remote_random" />
        <EditTextPreference
            app:icon="@drawable/ic_social_emoji_symbols"
            app:key="username"
            app:title="@string/username"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_social_emoji_symbols"
            app:key="password"
            app:title="@string/password" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/openvpn_cat_credentials">

        <EditTextPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="ca"
            app:title="@string/openvpn_ca"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="clientCert"
            app:title="@string/openvpn_client_cert"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="clientKey"
            app:title="@string/openvpn_client_key" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/openvpn_control_wrap_value"
            app:entryValues="@array/openvpn_control_wrap_value"
            app:icon="@drawable/ic_baseline_security_24"
            app:key="controlWrapType"
            app:title="@string/openvpn_control_wrap"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="controlWrapKey"
            app:title="@string/openvpn_control_wrap_key" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/openvpn_direction_value"
            app:entryValues="@array/openvpn_direction_value"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="controlWrapDirection"
            app:title="@string/openvpn_control_wrap_direction"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="staticKey"
            app:title="@string/openvpn_static_key" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/openvpn_direction_value"
            app:entryValues="@array/openvpn_direction_value"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="keyDirection"
            app:title="@string/openvpn_key_direction"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

