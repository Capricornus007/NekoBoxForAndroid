<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tailscale_status_title">Статус Tailscale</string>
    <string name="tailscale_status_entry">Статус, вхід та діагностика пірів для збереженого профілю. Незбережені зміни не використовуються.</string>
    <string name="tailscale_status_connecting">Підключення до служби…</string>
    <string name="tailscale_status_stopped">Цей збережений вузол не працює. Відкриття цього екрана не запускає його.</string>
    <string name="tailscale_status_check">Перевірити / увійти</string>
    <string name="tailscale_status_check_summary">Лише коли служба зупинена. Запускає тимчасовий вузол, а не VPN.</string>
    <string name="tailscale_status_starting">Запуск тимчасової перевірки…</string>
    <string name="tailscale_status_temporary">Тимчасова сесія, обмежена службою до трьох хвилин. Повернення з браузера входу зберігає ту саму сесію. Вихід з цього екрана завершує її.</string>
    <string name="tailscale_status_cancel">Скасувати тимчасову сесію</string>
    <string name="tailscale_status_closed">Сесію завершено. За потреби перевірте ще раз явно.</string>
    <string name="tailscale_status_error">Не вдалося завершити операцію. Перевірте збережений профіль і стан служби, потім спробуйте ще раз.</string>
    <string name="tailscale_status_backend">Стан вузла: %1$s</string>
