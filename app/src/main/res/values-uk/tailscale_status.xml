    <string name="tailscale_status_expiry_unknown">Закінчення ключа недоступне</string>
    <string name="tailscale_status_current_exit">Поточний вихід</string>
    <string name="tailscale_status_saved_exit">Збережений вихід</string>
    <string name="tailscale_status_none">Немає — лише tailnet</string>
    <string name="tailscale_status_exit_live">%1$s — активний</string>
    <string name="tailscale_status_exit_not_live">%1$s — неактивний</string>
    <string name="tailscale_status_exit_mismatch">Збережений вибір відрізняється від поточного виходу.</string>
    <string name="tailscale_status_exit_offer">Пропонує маршрутизацію виходу</string>
    <string name="tailscale_status_exit_selected">Вибраний вихід</string>
    <string name="tailscale_status_exit_action">Змінити і зберегти вихід</string>
    <string name="tailscale_status_exit_confirm">Застосувати %1$s до цього вузла і зберегти його у профілі? Екран чекає підтвердження як від вузла, так і від бази даних.</string>
    <string name="tailscale_status_none_warning">Немає зберігає доступними лише tailnet-адреси; він не надає вихід в Інтернет.</string>
    <string name="tailscale_status_exit_pending">Застосування та збереження вибору виходу…</string>
    <string name="tailscale_status_exit_saved">Вихід застосовано і збережено</string>
    <string name="tailscale_status_exit_next_start">Вихід збережено для наступного запуску</string>
    <string name="tailscale_status_exit_unchanged">Зміну виходу не вдалося; попередній вибір не змінено</string>
    <string name="tailscale_status_exit_rolled_back">Збереження не вдалося; попередній активний вихід відновлено</string>
    <string name="tailscale_status_exit_conflict">Збережений профіль змінився. Перегляньте поточний збережений вихід перед повторною спробою.</string>
    <string name="tailscale_status_exit_diverged">Активний і збережений виходи можуть відрізнятися. Перегляньте обидва стани; VPN не було перезапущено.</string>
    <string name="tailscale_status_exit_cancelled">Зміну виходу скасовано до застосування</string>
