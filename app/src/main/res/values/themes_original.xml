<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Original style: revert widget styles to upstream NekoBox appearance.
         作为 overlay 叠加在任意颜色主题（含 Dialog 主题）之上，见 Theme.apply。
         各值以官方仓库 themes.xml 为准：官方未设置的项回退到
         Theme.MaterialComponents 默认值（如 textInputStyle = FilledBox） -->

    <style name="ThemeOverlay.SagerNet.Original" parent="">
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.FilledBox</item>
        <item name="popupMenuStyle">@style/Widget.MaterialComponents.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.MaterialComponents.PopupMenu.Overflow</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MaterialComponents.BottomSheetDialog</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="elevatedCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <item name="tintedCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <!-- mod 在 Dialog 主题上设置了全局 shapeAppearanceOverlay，官方没有，清除之 -->
        <item name="shapeAppearanceOverlay">@null</item>
        <!-- 卡片次要小字回到官方行为：跟随 accentOrTextSecondary（Black 主题下为灰色）-->
        <item name="cardSubTextColor">?attr/accentOrTextSecondary</item>
    </style>

</resources>
