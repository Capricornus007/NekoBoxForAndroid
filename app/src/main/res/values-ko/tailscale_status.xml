<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tailscale_status_title">Tailscale 상태</string>
    <string name="tailscale_status_entry">저장된 프로필의 상태, 로그인 및 피어 진단. 저장되지 않은 편집은 사용되지 않습니다.</string>
    <string name="tailscale_status_connecting">서비스에 연결하는 중…</string>
    <string name="tailscale_status_stopped">이 저장된 노드가 실행되고 있지 않습니다. 이 화면을 열어도 시작되지 않습니다.</string>
    <string name="tailscale_status_check">확인 / 로그인</string>
    <string name="tailscale_status_check_summary">서비스가 중지된 경우에만. 임시 노드를 시작합니다(VPN 아님).</string>
    <string name="tailscale_status_starting">임시 확인 시작 중…</string>
    <string name="tailscale_status_temporary">임시 세션은 서비스에 의해 3분으로 제한됩니다. 로그인 브라우저에서 돌아와도 동일한 세션이 유지됩니다. 이 화면을 나가면 종료됩니다.</string>
    <string name="tailscale_status_cancel">임시 세션 취소</string>
    <string name="tailscale_status_closed">세션이 종료되었습니다. 필요하면 다시 확인하세요.</string>
    <string name="tailscale_status_error">작업을 완료할 수 없습니다. 저장된 프로필과 서비스 상태를 확인한 후 다시 시도하세요.</string>
    <string name="tailscale_status_backend">노드 상태: %1$s</string>
    <string name="tailscale_status_approval">관리자 승인 대기 중</string>
    <string name="tailscale_status_key_auth">Auth-key 로그인 구성됨</string>
    <string name="tailscale_status_interactive_auth">대화형 로그인 구성됨</string>
    <string name="tailscale_status_self">이 노드</string>
    <string name="tailscale_status_unknown">사용 불가</string>
