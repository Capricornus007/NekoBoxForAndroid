    <string name="tailscale_status_exit_not_live">%1$s — 비활성</string>
    <string name="tailscale_status_exit_mismatch">저장된 선택이 현재 출구와 다릅니다.</string>
    <string name="tailscale_status_exit_offer">출구 라우팅 제공</string>
    <string name="tailscale_status_exit_selected">선택된 출구</string>
    <string name="tailscale_status_exit_action">출구 변경 및 저장</string>
    <string name="tailscale_status_exit_confirm">%1$s을(를) 이 노드에 적용하고 프로필에 저장할까요? 화면은 노드와 데이터베이스의 확인을 모두 기다립니다.</string>
    <string name="tailscale_status_none_warning">없음은 tailnet 주소만 도달 가능하게 유지하며 인터넷 출구를 제공하지 않습니다.</string>
    <string name="tailscale_status_exit_pending">출구 선택 적용 및 저장 중…</string>
    <string name="tailscale_status_exit_saved">출구가 적용되고 저장되었습니다</string>
    <string name="tailscale_status_exit_next_start">다음 시작을 위해 출구 저장됨</string>
    <string name="tailscale_status_exit_unchanged">출구 변경 실패. 이전 선택은 변경되지 않았습니다</string>
    <string name="tailscale_status_exit_rolled_back">저장 실패. 이전 라이브 출구가 복원되었습니다</string>
    <string name="tailscale_status_exit_conflict">저장된 프로필이 변경되었습니다. 다시 시도하기 전에 현재 저장된 출구를 확인하세요.</string>
    <string name="tailscale_status_exit_diverged">라이브 출구와 저장된 출구가 다를 수 있습니다. 두 상태를 모두 확인하세요. VPN은 다시 시작되지 않았습니다.</string>
    <string name="tailscale_status_exit_cancelled">적용하기 전에 출구 변경이 취소되었습니다</string>
    <string name="tailscale_status_peers">피어</string>
    <string name="tailscale_status_no_peers">보고된 피어 없음</string>
    <string name="tailscale_status_inventory">%2$d개 중 %1$d개 피어 표시 — 인벤토리 불완전</string>
    <string name="tailscale_status_inventory_complete">%1$d개 피어</string>
    <string name="tailscale_status_ping">피어 ping</string>
    <string name="tailscale_status_ping_summary">명시적 disco RTT 테스트, 최대 5개 샘플, 10초. 자동 스윕 없음.</string>
    <string name="tailscale_status_ping_pending">피어 RTT 측정 중…</string>
    <string name="tailscale_status_ping_result">%1$s · %2$s · %3$s</string>
    <string name="tailscale_status_ping_latency">%1$.1f ms</string>
    <string name="tailscale_status_ping_error">핑 실패</string>
    <string name="tailscale_status_path_direct">직접</string>
    <string name="tailscale_status_path_derp">DERP %1$s</string>
    <string name="tailscale_status_path_peer_relay">피어 릴레이</string>
    <string name="tailscale_status_path_unknown">알 수 없는 경로</string>
    <string name="tailscale_status_cancel_request">요청 취소</string>
    <string name="tailscale_status_cancel_request_summary">이미 저장 중인 출구 변경은 저장을 완료하거나 롤백해야 합니다.</string>
    <string name="tailscale_status_login_origin">로그인 출처: %1$s</string>
    <string name="tailscale_login_http_warning">이 로그인 페이지는 HTTPS 보호 없는 HTTP를 사용합니다. 로그인 링크와 로그인 데이터가 네트워크의 다른 사람에게 노출될 수 있습니다. 이 연결을 신뢰하는 경우에만 계속하세요.</string>
    <string name="tailscale_login_continue">계속</string>
    <string name="tailscale_status_login_invalid">로그인 주소를 사용할 수 없거나 안전하지 않습니다. 저장된 제어 URL을 확인하세요.</string>
    <string name="tailscale_status_login_warning">인증되지 않은 기본 VPN 경로나 Android VPN 잠금 모드로 인해 브라우저가 이 페이지에 도달하지 못할 수 있습니다. 이 화면은 VPN이나 잠금 설정을 변경하지 않으며 라우팅을 우회하지 않습니다.</string>
    <string name="tailscale_editor_conflict">ID 또는 저장된 출구가 변경되었습니다. 초안은 그대로 있습니다. 출구를 변경하기 전에 편집기를 다시 열어 저장된 프로필을 검토하세요.</string>
    <string name="tailscale_editor_save_failed">프로필을 저장할 수 없습니다. 초안은 그대로 있습니다.</string>
</resources>
