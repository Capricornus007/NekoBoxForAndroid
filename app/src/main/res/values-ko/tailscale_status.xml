    <string name="tailscale_status_offline">오프라인</string>
    <string name="tailscale_status_expired">노드 키 만료됨</string>
    <string name="tailscale_status_expiry">키 만료: %1$s</string>
    <string name="tailscale_status_expiry_unknown">키 만료 정보 사용 불가</string>
    <string name="tailscale_status_current_exit">현재 출구</string>
    <string name="tailscale_status_saved_exit">저장된 출구</string>
    <string name="tailscale_status_none">없음 — tailnet만</string>
