 		}
-		g.selectedOutboundUDP = outbound
-		selected = true
+		g.recordSelection(N.NetworkTCP, outboundTCP)
+		g.selectedOutboundTCP.Store(outboundTCP)
+	}
+	outboundUDP, existsUDP := g.Select(N.NetworkUDP)
+	if outboundUDP == nil {
+		if g.strategy == "priority" && g.selectedOutboundUDP.Load() != nil {
+			g.recordSelection(N.NetworkUDP, nil)
+			g.selectedOutboundUDP.Store(nil)
+			updated = true
+		}
+	} else if g.selectedOutboundUDP.Load() == nil || (existsUDP && outboundUDP != g.selectedOutboundUDP.Load()) {
+		if g.selectedOutboundUDP.Load() != nil {
+			updated = true
+		}
+		g.recordSelection(N.NetworkUDP, outboundUDP)
