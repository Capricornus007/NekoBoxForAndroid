diff --git a/libcore/config_compat.go b/libcore/config_compat.go
new file mode 100644
index 0000000..2c8f085
--- /dev/null
+++ b/libcore/config_compat.go
@@ -0,0 +1,223 @@
+package libcore
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// Migrations affect only the runtime copy; imported and stored JSON stays intact.
+func decodeConfigOptions(ctx context.Context, content []byte, options *option.Options) error {
+	normalized, err := normalizeConfigJSON(ctx, content)
+	if err != nil {
+		return err
+	}
+	return options.UnmarshalJSONContext(ctx, normalized)
+}
+
+func normalizeConfigJSON(ctx context.Context, content []byte) ([]byte, error) {
+	decoder := json.NewDecoderContext(ctx, bytes.NewReader(content))
+	decoder.UseNumber()
+	var root map[string]any
+	if err := decoder.Decode(&root); err != nil {
+		return nil, err
+	}
+	if root == nil {
+		return nil, fmt.Errorf("configuration must be an object")
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return nil, fmt.Errorf("configuration must contain one JSON object")
+	}
+	inbounds, _ := root["inbounds"].([]any)
+	used := make(map[string]bool)
+	for _, item := range inbounds {
+		if inbound, ok := item.(map[string]any); ok {
+			if tag, ok := inbound["tag"].(string); ok {
+				used[tag] = true
+			}
+		}
+	}
+	var actions []any
+	for i, item := range inbounds {
+		inbound, ok := item.(map[string]any)
+		if !ok {
+			continue
+		}
+		sniff, _ := inbound["sniff"].(bool)
+		override, _ := inbound["sniff_override_destination"].(bool)
+		strategy, _ := inbound["domain_strategy"].(string)
+		unmapping, _ := inbound["udp_disable_domain_unmapping"].(bool)
+		if sniff || strategy != "" || unmapping {
+			tag, _ := inbound["tag"].(string)
+			if tag == "" {
+				for n := i; ; n++ {
+					tag = fmt.Sprintf("neko-legacy-inbound-%d", n)
+					if !used[tag] {
+						break
+					}
+				}
+				inbound["tag"], used[tag] = tag, true
+			}
+			if strategy != "" {
+				actions = append(actions, map[string]any{"inbound": []string{tag}, "action": "resolve", "strategy": strategy})
+			}
+			if sniff {
+				action := map[string]any{"inbound": []string{tag}, "action": "sniff", "override_destination": override}
+				if timeout, exists := inbound["sniff_timeout"]; exists {
+					action["timeout"] = timeout
+				}
+				actions = append(actions, action)
+			}
+			if unmapping {
+				actions = append(actions, map[string]any{"inbound": []string{tag}, "action": "route-options", "udp_disable_domain_unmapping": true})
+			}
+		}
+		for _, field := range []string{"sniff", "sniff_timeout", "sniff_override_destination", "domain_strategy", "udp_disable_domain_unmapping"} {
+			// Invalid values must reach strict core validation, rather than disappear.
+			value, exists := inbound[field]
+			if !exists {
+				continue
+			}
+			valid := false
+			switch field {
+			case "domain_strategy":
+				_, valid = value.(string)
+			case "sniff_timeout":
+				encoded, err := json.Marshal(value)
+				var timeout badoption.Duration
+				valid = err == nil && json.Unmarshal(encoded, &timeout) == nil
+			default:
+				_, valid = value.(bool)
+			}
+			if !valid {
+				return nil, fmt.Errorf("inbound[%d]: invalid %s", i, field)
+			}
+			delete(inbound, field)
+		}
+		if inbound["type"] == "tun" {
+			if value, exists := inbound["endpoint_independent_nat"]; exists {
+				enabled, ok := value.(bool)
+				if !ok {
+					return nil, fmt.Errorf("invalid endpoint_independent_nat")
+				}
+				behavior := "address_and_port_dependent"
+				if enabled {
+					behavior = "endpoint_independent"
+				}
+				for _, field := range []string{"udp_mapping", "udp_filtering"} {
+					if _, exists := inbound[field]; !exists {
+						inbound[field] = behavior
+					}
+				}
+				delete(inbound, "endpoint_independent_nat")
+			}
+		}
+	}
+	if len(actions) > 0 {
+		route, ok := root["route"].(map[string]any)
+		if !ok {
+			if value := root["route"]; value != nil {
+				return nil, fmt.Errorf("route must be an object")
+			}
+			route = make(map[string]any)
+			root["route"] = route
+		}
+		rules, ok := route["rules"].([]any)
+		if !ok && route["rules"] != nil {
+			return nil, fmt.Errorf("route.rules must be an array")
+		}
+		position := 0
+		for position < len(rules) && isEarlyNetworkGuard(rules[position]) {
+			position++
+		}
+		merged := make([]any, 0, len(rules)+len(actions))
+		merged = append(merged, rules[:position]...)
+		merged = append(merged, actions...)
+		merged = append(merged, rules[position:]...)
+		route["rules"] = merged
+	}
+	if dns, ok := root["dns"].(map[string]any); ok {
+		if err := migrateLegacyDNSServers(dns); err != nil {
+			return nil, err
+		}
+		rules, _ := dns["rules"].([]any)
+		if needsLegacyDNSRules(rules) {
+			preserveLegacyQueryTypes(rules)
+		}
+	}
+	return json.Marshal(root)
+}
+
+func isEarlyNetworkGuard(item any) bool {
+	rule, ok := item.(map[string]any)
+	if !ok || rule["action"] != "reject" {
+		return false
+	}
+	var hasUID func(map[string]any) bool
+	hasUID = func(rule map[string]any) bool {
+		if rule["user_id"] != nil || rule["package_name"] != nil {
+			return true
+		}
+		children, _ := rule["rules"].([]any)
+		for _, child := range children {
+			if nested, ok := child.(map[string]any); ok && hasUID(nested) {
+				return true
+			}
+		}
+		return false
+	}
+	if hasUID(rule) {
+		return true
+	}
+	// The app's virtual-DNS TLS guard is before sniffing and destination resolution.
+	ports, _ := rule["port"].([]any)
+	for _, port := range ports {
+		if fmt.Sprint(port) == "853" && rule["ip_cidr"] != nil {
+			return true
+		}
+	}
+	return false
+}
+
+func needsLegacyDNSRules(rules []any) bool {
+	for _, item := range rules {
+		rule, ok := item.(map[string]any)
+		if !ok {
+			continue
+		}
+		if strategy, _ := rule["strategy"].(string); strategy != "" {
+			return true
+		}
+		if rule["match_response"] == nil && (rule["ip_cidr"] != nil || rule["ip_is_private"] == true || rule["ip_accept_any"] == true || rule["rule_set_ip_cidr_accept_empty"] == true) {
+			return true
+		}
+		if children, ok := rule["rules"].([]any); ok && needsLegacyDNSRules(children) {
+			return true
+		}
+	}
+	return false
+}
+
+func preserveLegacyQueryTypes(rules []any) {
+	for _, item := range rules {
+		rule, ok := item.(map[string]any)
+		if !ok {
+			continue
+		}
+		if value, exists := rule["query_type"]; exists {
+			if rule["neko_legacy_query_type"] == nil {
+				rule["neko_legacy_query_type"] = value
+				delete(rule, "query_type")
+			}
+		}
+		if children, ok := rule["rules"].([]any); ok {
+			preserveLegacyQueryTypes(children)
+		}
+	}
+}
diff --git a/libcore/config_compat_test.go b/libcore/config_compat_test.go
new file mode 100644
index 0000000..c5cb71c
--- /dev/null
+++ b/libcore/config_compat_test.go
@@ -0,0 +1,90 @@
+package libcore
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func normalizedConfig(t *testing.T, raw string) map[string]any {
+	t.Helper()
+	value, err := normalizeConfigJSON(context.Background(), []byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var root map[string]any
+	if err := json.Unmarshal(value, &root); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+
+func TestLegacyInboundMigrationKeepsGuardsBeforeDNSAndSniffing(t *testing.T) {
+	const raw = `{"inbounds":[{"type":"tun","tag":"tun-in","address":["172.19.0.1/28"],"sniff":true,"sniff_override_destination":true,"sniff_timeout":"500ms","domain_strategy":"prefer_ipv4","endpoint_independent_nat":true}],"outbounds":[{"type":"direct","tag":"direct"}],"route":{"rules":[{"inbound":["tun-in"],"user_id":[23456],"action":"reject"},{"inbound":["tun-in"],"port":[853],"ip_cidr":["172.19.0.2/32"],"action":"reject"},{"port":[53],"action":"hijack-dns"}],"final":"direct"}}`
+	root := normalizedConfig(t, raw)
+	inbound := root["inbounds"].([]any)[0].(map[string]any)
+	if inbound["sniff"] != nil || inbound["domain_strategy"] != nil || inbound["endpoint_independent_nat"] != nil {
+		t.Fatal("legacy fields survived")
+	}
+	if inbound["udp_mapping"] != "endpoint_independent" {
+		t.Fatal("changed UDP mapping")
+	}
+	rules := root["route"].(map[string]any)["rules"].([]any)
+	for i, action := range []string{"reject", "reject", "resolve", "sniff", "hijack-dns"} {
+		if rules[i].(map[string]any)["action"] != action {
+			t.Fatalf("changed guard order at %d", i)
+		}
+	}
+	if rules[3].(map[string]any)["override_destination"] != true {
+		t.Fatal("lost destination override")
+	}
+	if err := CheckConfig(raw, nil); err != nil {
+		t.Fatal(err)
+	}
+	encoded, _ := json.Marshal(root)
+	if again := normalizedConfig(t, string(encoded)); !reflect.DeepEqual(root, again) {
+		t.Fatal("migration must be idempotent")
+	}
+}
+
+func TestLegacyMigrationPreservesUserFieldsAndRejectsMalformedInput(t *testing.T) {
+	const raw = `{"opaque":{"number":9007199254740993,"password":"test-fixture"},"inbounds":[{"type":"socks","tag":"neko-legacy-inbound-1"},{"type":"socks","sniff":true}],"route":{"rules":[{"action":"reject","domain":["blocked.example"]}]}}`
+	result, err := normalizeConfigJSON(context.Background(), []byte(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(result), "9007199254740993") {
+		t.Fatal("changed an exact numeric value")
+	}
+	root := normalizedConfig(t, string(result))
+	items := root["inbounds"].([]any)
+	if items[0].(map[string]any)["tag"] == items[1].(map[string]any)["tag"] {
+		t.Fatal("generated a duplicate tag")
+	}
+	if root["opaque"].(map[string]any)["password"] != "test-fixture" {
+		t.Fatal("modified unrelated user options")
+	}
+	for _, raw := range []string{`{} {}`, `null`, `{"inbounds":[{"sniff":"yes"}]}`, `{"inbounds":[{"sniff_timeout":false}]}`, `{"inbounds":[{"sniff":true}],"route":{"rules":{}}}`} {
+		if _, err := normalizeConfigJSON(context.Background(), []byte(raw)); err == nil {
+			t.Fatalf("accepted malformed config: %s", raw)
+		}
+	}
+	if err := CheckConfig(`{"unknown_option":true}`, nil); err == nil {
+		t.Fatal("migration must retain strict core validation")
+	}
+}
+
+func TestLegacyDNSCompatibilityDoesNotRewriteModernRules(t *testing.T) {
+	legacy := normalizedConfig(t, `{"dns":{"rules":[{"query_type":["A","AAAA"],"strategy":"ipv4_only","server":"fake"}]}}`)
+	rule := legacy["dns"].(map[string]any)["rules"].([]any)[0].(map[string]any)
+	if rule["query_type"] != nil || rule["neko_legacy_query_type"] == nil || rule["strategy"] != "ipv4_only" {
+		t.Fatal("lost legacy DNS family/query behavior")
+	}
+	modern := normalizedConfig(t, `{"dns":{"rules":[{"query_type":["A"],"ip_version":4,"server":"modern"}]}}`)
+	rule = modern["dns"].(map[string]any)["rules"].([]any)[0].(map[string]any)
+	if rule["query_type"] == nil || rule["neko_legacy_query_type"] != nil {
+		t.Fatal("changed native 1.14 DNS semantics")
+	}
+}
